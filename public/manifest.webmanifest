{
  "id": "./",
  "name": "Nexo — Tu universo personal",
  "short_name": "Nexo",
  "description": "Tu memoria personal, conectada.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8f9f6",
  "theme_color": "#f5f5f0",
  "categories": ["productivity", "lifestyle", "education"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "nexo-favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Registrar movimiento",
      "short_name": "Movimiento",
      "url": "./?nuevo=movimiento",
      "icons": [{ "src": "shortcut-movimiento.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Nuevo instante",
      "short_name": "Instante",
      "url": "./?nuevo=instante",
      "icons": [{ "src": "shortcut-instante.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Nueva nota",
      "short_name": "Nota",
      "url": "./#/libroteca/nueva",
      "icons": [{ "src": "shortcut-nota.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Nueva persona",
      "short_name": "Persona",
      "url": "./?nuevo=persona",
      "icons": [{ "src": "shortcut-persona.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
